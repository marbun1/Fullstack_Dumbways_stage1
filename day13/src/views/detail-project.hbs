<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{project.project_name}}</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/style.css">
</head>

<body class="bg-light">

<nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
  <div class="container">
    <a class="navbar-brand" href="/home"><i class="fa-solid fa-sailboat"></i></a>
    <div class="collapse navbar-collapse">
      <ul class="navbar-nav me-auto">
        <li class="nav-item"><a class="nav-link" href="/home">Home</a></li>
        <li class="nav-item"><a class="nav-link active" href="/my-project">My Project</a></li>
      </ul>
      <a class="btn btn-primary" href="/contact">Contact Me</a>
    </div>
  </div>
</nav>

<div class="container" style="margin-top:120px;">
  <div class="card shadow-sm p-4">

    <h2 class="mb-3">{{project.project_name}}</h2>

    <div class="row">
      <!-- IMAGE -->
      <div class="col-md-5">
        {{#if project.image}}
          <img src="{{project.image}}" class="img-fluid rounded mb-3">
        {{else}}
          <div class="bg-secondary text-white text-center p-5 rounded">
            No Image
          </div>
        {{/if}}
      </div>

      <!-- INFO -->
      <div class="col-md-7">
        <p class="text-muted mb-1">
          <b>Duration:</b>
          {{project.start_date}} → {{project.end_date}}
        </p>

        <hr>

        <h5>Description</h5>
        <p>{{project.description}}</p>

        <h5 class="mt-3">Technologies</h5>
        {{#each project.tech}}
          <span class="badge bg-dark me-1 mb-1">{{this}}</span>
        {{/each}}
      </div>
    </div>

    <div class="text-end mt-4">
      <a href="/my-project" class="btn btn-outline-primary">
        ← Back to My Project
      </a>
    </div>

  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
