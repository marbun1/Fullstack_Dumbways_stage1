<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Detail Project</title>
  <link rel="stylesheet" href="/assets/css/style.css" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
</head>

<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
    <div class="container">
      <a class="navbar-brand" href="/home"><i class="fa-solid fa-sailboat"></i></a>
      <button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="nav">
        <ul class="navbar-nav me-auto">
          <li class="nav-item"><a class="nav-link" href="/home">Home</a></li>
          <li class="nav-item"><a class="nav-link active" href="/my-project">My Project</a></li>
        </ul>
        <a class="btn btn-primary" href="/contact">Contact Me</a>
      </div>
    </div>
  </nav>
  <div class="container" style="margin-top: 100px;">
    <h1>{{project.projectName}}</h1>

    {{#if project.image}}
      <img src="{{project.image}}" alt="{{project.projectName}}" class="img-fluid mb-3" style="max-width:400px;">
    {{/if}}

    <p><strong>Deskripsi:</strong> {{project.description}}</p>
    <p><strong>Start Date:</strong> {{project.startDate}}</p>
    <p><strong>End Date:</strong> {{project.endDate}}</p>
    <p><strong>Tech:</strong>
      {{#each project.tech}}
        <span class="badge bg-secondary">{{this}}</span>
      {{/each}}
    </p>
    <a href="/my-project" class="btn btn-outline-primary mt-3">Kembali ke My Project</a>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
