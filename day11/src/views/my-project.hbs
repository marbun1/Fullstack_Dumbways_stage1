<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>My Project</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/style.css">
</head>

<body>

  <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
    <div class="container">
      <a class="navbar-brand" href="/home"><i class="fa-solid fa-sailboat"></i></a>
      <button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="nav">
        <ul class="navbar-nav me-auto">
          <li class="nav-item"><a class="nav-link" href="/home">Home</a></li>
          <li class="nav-item"><a class="nav-link active" href="/my-project">My Project</a></li>
        </ul>
        <a class="btn btn-primary" href="/contact">Contact Me</a>
      </div>
    </div>
  </nav>

  <!-- Form tambah project -->
  <div class="form-myProject mt-5 pt-5">
    <h2>ADD MY PROJECT</h2>
    <form action="/add-project" method="POST" enctype="multipart/form-data">
      <label class="fw-semibold">Project Name</label>
      <input type="text" class="form-control mb-3" name="projectName" required>

      <div class="row">
        <div class="col">
          <label class="fw-semibold">Start Date</label>
          <input type="date" class="form-control mb-3" name="startDate" required>
        </div>
        <div class="col">
          <label class="fw-semibold">End Date</label>
          <input type="date" class="form-control mb-3" name="endDate" required>
        </div>
      </div>

      <label class="fw-semibold">Description</label>
      <textarea class="form-control mb-3" rows="4" name="description" required></textarea>

      <label class="fw-semibold">Technologies</label>
      <div class="tech-container mb-3">
        <div class="tech-item">
          <input type="checkbox" id="node" name="tech" value="Node JS">
          <label for="node">Node JS</label>
        </div>
        <div class="tech-item">
          <input type="checkbox" id="react" name="tech" value="React JS">
          <label for="react">React JS</label>
        </div>
        <div class="tech-item">
          <input type="checkbox" id="next" name="tech" value="Next JS">
          <label for="next">Next JS</label>
        </div>
        <div class="tech-item">
          <input type="checkbox" id="ts" name="tech" value="TypeScript">
          <label for="ts">TypeScript</label>
        </div>
      </div>

      <label class="fw-semibold">Upload Image</label>
      <input type="file" class="form-control mb-4" name="image" accept="image/*">

      <div class="text-end">
        <button type="submit" class="btn-submit btn btn-primary">Submit</button>
      </div>
    </form>
  </div>

  <!-- List project -->
  <div class="container mt-5 mb-5">
    <h3 class="mb-4">List Project</h3>

    <div class="row">
      {{#each projects}}
        <div class="col-md-4 mb-4">
          <!-- Card clickable -->
          <a href="/project/{{this.id}}" style="text-decoration:none; color:inherit;">
            <div class="card p-3 shadow-sm">
              {{#if this.image}}
                <img src="{{this.image}}" class="img-fluid mb-2" />
              {{/if}}

              <h5>{{this.projectName}}</h5>
              <p><b>Date:</b> {{this.startDate}} → {{this.endDate}}</p>
              <p>{{this.description}}</p>
            </div>
          </a>
          <button class="btn btn-danger btn-sm mt-2" onclick="deleteProject({{this.id}})">Hapus</button>
        </div>
      {{/each}}
    </div>
  </div>

  <script src="/assets/js/delete.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
